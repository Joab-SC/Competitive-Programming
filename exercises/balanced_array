def main():
    t = int(input())
    for _ in range(t):
        n = int(input())
        if n % 4 ==0:
            print("YES")
            print(" ".join(map(str, construct_array(n))))
        else:
            print("NO")
def construct_array(n):
    arr = [0] * n
    pair_ind = 0
    impair_ind = int(n/2)
    for i in range(1,n+1):
        if i%2 == 0:
             arr[pair_ind] = i
             pair_ind+=1
        else:
            arr[impair_ind] = i
            impair_ind+=1
    arr[-1] += int(n/2)
    return arr
main()